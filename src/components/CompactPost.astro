---
import type { CollectionEntry } from 'astro:content';
import SiteImage from './SiteImage.astro';
import { formatDate } from '../lib/posts';

interface Props {
  post: CollectionEntry<'blog'>;
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const href = `/${post.data.slug}/`;
---

<a class="compact-post" href={href}>
  <div class="compact-post-text">
    <h3 class="compact-post-title">{post.data.title}</h3>
    <div class="card-meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    </div>
  </div>
  {
    post.data.feature_image && (
      <div class="compact-post-thumb">
        <SiteImage
          src={post.data.feature_image}
          alt=""
          width={144}
          height={144}
          loading={eager ? 'eager' : 'lazy'}
          widths={[72, 144]}
          sizes="72px"
        />
      </div>
    )
  }
</a>
