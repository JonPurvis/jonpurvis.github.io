---
import type { CollectionEntry } from 'astro:content';
import SiteImage from './SiteImage.astro';
import { formatDate, excerptFrom } from '../lib/posts';

interface Props {
  post: CollectionEntry<'blog'>;
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const href = `/${post.data.slug}/`;
---

<a class="card" href={href}>
  {
    post.data.feature_image && (
      <div class="card-image">
        <SiteImage
          src={post.data.feature_image}
          alt=""
          width={800}
          height={450}
          loading={eager ? 'eager' : 'lazy'}
          widths={[400, 600, 800]}
          sizes="(min-width: 960px) 30vw, (min-width: 640px) 45vw, 100vw"
        />
      </div>
    )
  }
  <div class="card-body">
    <h3 class="card-title">{post.data.title}</h3>
    <p class="card-excerpt">{excerptFrom(post, 65)}</p>
    <div class="card-meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    </div>
  </div>
</a>
