---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TwitterEmbeds from '../components/TwitterEmbeds.astro';
import { SITE_TITLE, SITE_URL, SITE_LOGO, TAG_LABELS, SOCIAL_LINKS, OG_IMAGE_WIDTH, OG_IMAGE_HEIGHT } from '../consts';
import {
  formatDate,
  readingTime,
  tagLabel,
  primaryTag,
  excerptFrom,
} from '../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const pages = (await getCollection('pages')).filter((p) => p.data.slug !== 'packages');

  return [
    ...posts.map((post) => ({
      params: { slug: post.data.slug },
      props: { kind: 'post' as const, post, page: undefined as undefined },
    })),
    ...pages.map((page) => ({
      params: { slug: page.data.slug },
      props: { kind: 'page' as const, page, post: undefined as undefined },
    })),
  ];
}

interface Props {
  kind: 'post' | 'page';
  post?: CollectionEntry<'blog'>;
  page?: CollectionEntry<'pages'>;
}

const { kind, post, page } = Astro.props as Props;
const entry = (kind === 'post' ? post : page)!;
const { Content } = await render(entry);

const isPost = kind === 'post' && post;
const tag = isPost ? primaryTag(post.data.tags) : undefined;
const description = isPost
  ? excerptFrom(post, 220)
  : (page?.data.excerpt ?? `${page?.data.title} — ${SITE_TITLE}`);
const minutes = isPost ? readingTime(post.body ?? '') : 0;
const absoluteUrl = (path?: string) => {
  if (!path) return undefined;
  return path.startsWith('http') ? path : new URL(path, SITE_URL).href;
};
const featureImage = isPost ? post.data.feature_image : undefined;
const featureImageUrl = absoluteUrl(featureImage);
const tagLabels = isPost ? post.data.tags.map((t) => TAG_LABELS[t] ?? tagLabel(t)) : [];
const pageUrl = `${SITE_URL}/${entry.data.slug}/`;

const jsonLd = isPost
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      publisher: {
        '@type': 'Organization',
        name: SITE_TITLE,
        url: `${SITE_URL}/`,
        logo: {
          '@type': 'ImageObject',
          url: absoluteUrl(SITE_LOGO),
          width: 60,
          height: 60,
        },
      },
      author: {
        '@type': 'Person',
        name: SITE_TITLE,
        url: `${SITE_URL}/about/`,
        sameAs: SOCIAL_LINKS.map((link) => link.href),
      },
      headline: post.data.title,
      url: pageUrl,
      datePublished: post.data.date.toISOString(),
      dateModified: (post.data.updated ?? post.data.date).toISOString(),
      ...(featureImageUrl
        ? {
            image: {
              '@type': 'ImageObject',
              url: featureImageUrl,
              width: OG_IMAGE_WIDTH,
              height: OG_IMAGE_HEIGHT,
            },
          }
        : {}),
      ...(tagLabels.length ? { keywords: tagLabels.join(', ') } : {}),
      description,
      mainEntityOfPage: pageUrl,
    }
  : null;
---

<BaseLayout
  title={entry.data.title}
  description={description}
  image={featureImage}
  canonical={`/${entry.data.slug}/`}
  type={isPost ? 'article' : 'website'}
  publishedTime={isPost ? post.data.date : undefined}
  modifiedTime={isPost ? (post.data.updated ?? post.data.date) : undefined}
  tags={tagLabels}
  jsonLd={jsonLd}
>

  <div data-pagefind-body data-pagefind-meta={isPost ? 'type:post' : 'type:page'}>
  {
    isPost ? (
      <header class="post-header">
        <div class="content-width">
          {tag && (
            <a class="post-tag" href={`/tag/${tag}/`}>
              {tagLabel(tag)}
            </a>
          )}
          <h1 class="post-title" data-pagefind-meta="title">{post.data.title}</h1>
          <div class="post-meta">
            <time datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
            <span> — {minutes} min read</span>
          </div>
        </div>
      </header>
    ) : (
      <header class="page-header page-header-tight">
        <div class="content-width">
          <h1 data-pagefind-meta="title">{page!.data.title}</h1>
        </div>
      </header>
    )
  }

  <article class="post-body content-width">
    {
      isPost && post.data.photo_album && (
        <a class="callout photo-album-cta" href={`/${post.data.slug}/photos/`}>
          <strong>See the photo album</strong>
          View photos from this post in the gallery.
        </a>
      )
    }
    <Content />
    {
      isPost && post.data.tags.length > 0 && (
        <div class="post-tags">
          {post.data.tags.map((t) => (
            <a href={`/tag/${t}/`}>{TAG_LABELS[t] ?? t}</a>
          ))}
        </div>
      )
    }
  </article>
  </div>
  <TwitterEmbeds />
</BaseLayout>
