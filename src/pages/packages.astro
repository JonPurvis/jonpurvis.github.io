---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookmarkCard from '../components/BookmarkCard.astro';
import { PACKAGES } from '../data/packages';
import { SITE_TITLE } from '../consts';

const title = 'Packages';
const description =
  '15,000,000+ Downloads and Counting. Most of my packages start the exact same way: I hit a real-world roadblock in a project, build a custom solution to solve it, and then refine it into an open-source tool.';
---

<BaseLayout title={title} description={description} canonical="/packages/">
  <div data-pagefind-body data-pagefind-meta="type:page">
  <header class="page-header page-header-tight">
    <div class="content-width">
      <h1 data-pagefind-meta="title">{title}</h1>
    </div>
  </header>
  <article class="post-body content-width">
    <p>
      <strong>15,000,000+ Downloads and Counting.</strong> Most of my packages start the exact same
      way: I hit a real-world roadblock in a project, build a custom solution to solve it, and then
      refine it into an open-source tool that the wider community can use.
    </p>
    {
      PACKAGES.map((pkg, i) => (
        <BookmarkCard
          href={pkg.href}
          title={pkg.title}
          description={pkg.description}
          author={pkg.author}
          image={pkg.image}
          caption={pkg.caption}
          eager={i < 4}
          eagerIcon={i < 3}
        />
      ))
    }
  </article>
  </div>
</BaseLayout>
